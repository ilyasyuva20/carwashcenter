PORT=4000

# Vehicle Lookup Primary Mode: 'rapidapi' | 'custom_api' | 'apisetu' | 'puppeteer'
LOOKUP_METHOD=rapidapi

# RapidAPI VAHAN Provider
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=rto-vehicle-info-api.p.rapidapi.com

# Custom Indian RTO Provider (APICountry / Surepass / Cashfree)
# RTO_API_URL=https://api.apicountry.com/vahan/rc
# RTO_API_KEY=your_custom_key

# APISetu MoRTH API
APISETU_CLIENT_ID=com.carwashprodesigners
APISETU_API_KEY=

DATABASE_URL=
OCR_SPACE_API_KEY=
PLATE_RECOGNIZER_API_KEY=
